{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hassantraining84",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hassan-training-db-8",
      "database_id": "f0ac5c4a-0aac-41fb-b505-761cac17ee88"
    }
  ],
  "vars": {
    "ALLOW_DB_WRITES": "false"
  }
}